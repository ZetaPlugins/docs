{
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": true,
    "printWidth": 120,
    "plugins": ["prettier-plugin-astro"],
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "parser": "astro"
            }
        },
        {
            "files": "*.md",
            "options": {
                "embeddedLanguageFormatting": "off"
            }
        }
    ]
}
