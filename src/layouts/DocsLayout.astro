---
import type { MarkdownHeading } from 'astro';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import Search from '../components/Search.astro';
import type { Product } from '../lib/nav';
import { OG_HEIGHT, OG_WIDTH, ogImagePath } from '../lib/og';

interface Props {
    title: string;
    description?: string;
    products: Product[];
    product: Product;
    currentId: string;
    headings?: MarkdownHeading[];
}
const { title, description, products, product, currentId, headings = [] } = Astro.props;
const pageTitle =
    title === 'ZetaPlugins'
        ? 'ZetaPlugins Docs'
        : title === product.title || !product.slug
          ? `${title} | ZetaPlugins`
          : `${title} | ${product.title}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath(currentId || 'index'), Astro.site);
---

<!doctype html>
<html lang="en" style={product.accent ? `--brand: ${product.accent}` : undefined}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{pageTitle}</title>
        {description && <meta name="description" content={description} />}
        <meta property="og:title" content={pageTitle} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="ZetaPlugins Docs" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content={String(OG_WIDTH)} />
        <meta property="og:image:height" content={String(OG_HEIGHT)} />
        <meta property="og:image:alt" content={pageTitle} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        {description && <meta name="twitter:description" content={description} />}
        <meta name="twitter:image" content={ogImage} />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
        <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
        <link rel="manifest" href="/favicons/site.webmanifest" />
        <script is:inline>
            (() => {
                let theme;
                try {
                    theme = localStorage.getItem('theme');
                } catch {}
                if (theme !== 'light' && theme !== 'dark') {
                    theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                }
                document.documentElement.dataset.theme = theme;
            })();
        </script>
    </head>
    <body>
        <a class="skip-link" href="#content">
            Skip to content
        </a>
        <Header />
        <div class="layout">
            <Sidebar products={products} current={product} currentId={currentId} />
            <main id="content" class="main">
                <slot />
            </main>
            <Toc headings={headings} />
        </div>
        <Search />

        <script>
            import '../scripts/docs';
        </script>
    </body>
</html>
