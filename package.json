{
    "name": "zeta-docs",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "astro build && pagefind --site dist",
        "preview": "astro preview --port 8010",
        "start": "astro preview --port 8010 --host",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "restart": "pm2 restart zeta-docs"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "^7.3.6",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@lucide/astro": "^1.70.0",
        "astro": "^7.4.7",
        "remark-directive": "^4.0.0",
        "unist-util-visit": "^5.2.0"
    },
    "devDependencies": {
        "pagefind": "^1.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.2",
        "typescript": "^6.0.3"
    }
}
